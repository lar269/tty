# Файл конфигурации для AT-команд Сервера
# Формат: ЗАПРОС_ОТ_КЛИЕНТА=ОТВЕТ_СЕРВЕРА

# 1. Базовая проверка связи
# Клиент шлет "AT", сервер отвечает "OK"
AT=OK

# 2. Управление эхо
# Клиент шлет "ATE0", сервер подтверждает "OK"
ATE0=OK
# Клиент шлет "ATE1"  сервер подтверждает "OK"
ATE1=OK


# 3. Информация об устройстве
# Клиент шлет "ATI", сервер возвращает данные и "OK"
ATI=Manufacturer: MyServer\rModel: VirtualModem\rRevision: 1.0\rOK

# 4. Статус SIM-карты
# Клиент шлет "AT+CPIN", сервер отвечает статусом
AT+CPIN=+CPIN: READY\rOK

# 5. Оператор сети
# Клиент шлет "AT+COPS", сервер отвечает данными оператора
AT+COPS=+COPS: 0,0,"VirtualNet",7\rOK



# Команда по умолчанию, если запрос не найден
DEFAULT=ERROR